{
  "name": "architecture-cleaner",
  "version": "0.1.0",
  "description": "Restructure a type-sliced TypeScript backend into feature modules, one certified commit at a time.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ac": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "profiles",
    "cassettes",
    "runs",
    "budget/runs.json",
    "budget/ledger.jsonl",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli/main.js', 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ac": "node dist/cli/main.js",
    "mutants": "node dist/mutation/run.js"
  },
  "dependencies": {
    "dependency-cruiser": "^18.6.0",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "openai": "^7.30.0",
    "typescript": "6.0.3",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "vitest": "5.0.3"
  }
}
